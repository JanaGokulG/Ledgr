# ==========================================
# Banking API Configuration
# ==========================================
BANKING_API_CLIENT_ID=your_api_client_id_here
BANKING_API_SECRET=your_api_secret_here
BANKING_API_ENV=sandbox
BANKING_API_BASE_URL=https://sandbox.plaid.com
BANKING_INSTITUTION_ID=ins_20
BANKING_WEBHOOK_URL=https://www.genericwebhookurl.com/webhook
BANKING_OVERRIDE_USERNAME=user_good
BANKING_OVERRIDE_PASSWORD=pass_good
BANKING_INITIAL_PRODUCTS=auth,transactions,identity,investments,liabilities
# Delay specifically between two transactions being fetched / ingested (in ms)
TRANSACTION_DELAY_MS=150

# Legacy compatibility aliases
PLAID_CLIENT_ID=your_api_client_id_here
PLAID_SECRET=your_api_secret_here
PLAID_ENV=sandbox

# ==========================================
# Database & Server Settings
# ==========================================
DB_URL=jdbc:postgresql://localhost:5432/ledgr_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
SERVER_PORT=8085
